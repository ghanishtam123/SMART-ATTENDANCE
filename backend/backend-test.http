### Create Subject
# @name createSubject
POST {{baseUrl}}/subjects
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Artificial Intelligence",
  "code": "AI601",
  "description": "AI fundamentals and practical applications",
  "creditHours": 4,
  "classGroupIds": ["{{classGroupId}}"],
  "isActive": true
}

> {%
const body = response.body || {};
const data = body.data || body;
if (data._id) client.global.set("subjectId", data._id);
%}

### Get Subjects
GET {{baseUrl}}/subjects
Authorization: Bearer {{token}}

### Get Subject By Id
GET {{baseUrl}}/subjects/{{subjectId}}
Authorization: Bearer {{token}}

### Update Subject
PATCH {{baseUrl}}/subjects/{{subjectId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "creditHours": 5
}

