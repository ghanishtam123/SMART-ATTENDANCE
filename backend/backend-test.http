@host = http://localhost:5001
@baseUrl = {{host}}/api/v1
@healthUrl = {{host}}/health

# =========================
# STATIC CONFIG
# =========================
@superAdminEmail = superadmin@example.com
@superAdminPassword = Admin@123

@adminEmail = admin@example.com
@adminPassword = Admin@123

@teacherEmail = teacher1@example.com
@teacherPassword = Teacher@123

@aiApiKey = smart_attendance_ai_key_987654321

# =========================
# HEALTH
# =========================

### Health Check
GET {{healthUrl}}

# =========================
# AUTH
# =========================

### Register Super Admin (use only if bootstrap register is allowed)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "fullName": "Super Admin",
  "email": "{{superAdminEmail}}",
  "password": "{{superAdminPassword}}",
  "role": "super_admin"
}

### Login Super Admin
# @name loginSuperAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{superAdminEmail}}",
  "password": "{{superAdminPassword}}"
}

> {%
const body = response.body || {};
const data = body.data || body;
if (data.token) client.global.set("token", data.token);
if (data.user && data.user._id) client.global.set("superAdminId", data.user._id);
%}

### Current User Profile
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

### Login Wrong Password (negative test)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{superAdminEmail}}",
  "password": "WrongPassword123"
}

### Protected Route Without Token (negative test)
GET {{baseUrl}}/auth/me

# =========================
# USERS
# =========================

### Create Admin User
# @name createAdminUser
POST {{baseUrl}}/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fullName": "Main Admin",
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}",
  "role": "admin"
}

> {%
const body = response.body || {};
const data = body.data || body;
if (data._id) client.global.set("adminId", data._id);
%}

### Create Teacher User
# @name createTeacherUser
POST {{baseUrl}}/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fullName": "Teacher One",
  "email": "{{teacherEmail}}",
  "password": "{{teacherPassword}}",
  "role": "teacher"
}

> {%
const body = response.body || {};
const data = body.data || body;
if (data._id) client.global.set("teacherUserId", data._id);
%}

### Get Users List
GET {{baseUrl}}/users
Authorization: Bearer {{token}}

# =========================
# CLASS GROUPS
# =========================

### Create Class Group
# @name createClassGroup
POST {{baseUrl}}/class-groups
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "BCA 3rd Year A",
  "code": "BCA3A",
  "department": "Computer Science",
  "semester": 6,
  "section": "A",
  "academicYear": "2025-2026",
  "isActive": true
}

> {%
const body = response.body || {};
const data = body.data || body;
if (data._id) client.global.set("classGroupId", data._id);
%}

### Get Class Groups
GET {{baseUrl}}/class-groups
Authorization: Bearer {{token}}

### Get Class Group By Id
GET {{baseUrl}}/class-groups/{{classGroupId}}
Authorization: Bearer {{token}}

### Update Class Group
PATCH {{baseUrl}}/class-groups/{{classGroupId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "section": "A1"
}

### Duplicate Class Group Code (negative test)
POST {{baseUrl}}/class-groups
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Duplicate BCA 3rd Year A",
  "code": "BCA3A",
  "department": "Computer Science",
  "semester": 6,
  "section": "B",
  "academicYear": "2025-2026",
  "isActive": true
}

