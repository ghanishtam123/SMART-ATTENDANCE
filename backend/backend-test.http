### Create Classroom
# @name createClassroom
POST {{baseUrl}}/classrooms
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Smart Room 101",
  "code": "SR101",
  "building": "Main Block",
  "floor": 1,
  "capacity": 60,
  "cameraIds": ["cam-01"],
  "isActive": true
}

> {%
const body = response.body || {};
const data = body.data || body;
if (data._id) client.global.set("classroomId", data._id);
%}

### Get Classrooms
GET {{baseUrl}}/classrooms
Authorization: Bearer {{token}}

### Get Classroom By Id
GET {{baseUrl}}/classrooms/{{classroomId}}
Authorization: Bearer {{token}}

### Update Classroom
PATCH {{baseUrl}}/classrooms/{{classroomId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "capacity": 70,
  "cameraIds": ["cam-01", "cam-02"]
}

# =========================
# SUBJECTS
