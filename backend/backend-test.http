# =========================
# SESSIONS
# =========================

### Create Session
# @name createSession
POST {{baseUrl}}/sessions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "AI Lecture 1",
  "classGroupId": "{{classGroupId}}",
  "subjectId": "{{subjectId}}",
  "teacherId": "{{teacherProfileId}}",
  "classroomId": "{{classroomId}}",
  "cameraIds": ["cam-01"],
  "scheduledDate": "2026-03-12",
  "scheduledStartTime": "2026-03-12T10:00:00.000Z",
  "scheduledEndTime": "2026-03-12T11:00:00.000Z",
  "graceMinutesForLate": 10,
  "minimumPresenceMinutes": 30,
  "minimumPresencePercentage": 60,
  "status": "created"
}

> {%
const body = response.body || {};
const data = body.data || body;
if (data._id) client.global.set("sessionId", data._id);
%}

### Get Sessions
GET {{baseUrl}}/sessions
Authorization: Bearer {{token}}

### Get Session By Id
GET {{baseUrl}}/sessions/{{sessionId}}
Authorization: Bearer {{token}}

### Update Session
PATCH {{baseUrl}}/sessions/{{sessionId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "notes": "Updated before starting session"
}

### Start Session
POST {{baseUrl}}/sessions/{{sessionId}}/start
Authorization: Bearer {{token}}

### Complete Session
POST {{baseUrl}}/sessions/{{sessionId}}/complete
Authorization: Bearer {{token}}

### Archive Session
POST {{baseUrl}}/sessions/{{sessionId}}/archive
Authorization: Bearer {{token}}

# =========================
# AI RECOGNITION EVENTS
# =========================

### Send Known Recognition Events - Batch 1
POST {{baseUrl}}/ai/recognition-events
x-ai-api-key: {{aiApiKey}}
Content-Type: application/json

{
  "sessionId": "{{sessionId}}",
  "cameraId": "cam-01",
  "events": [
    {
      "studentId": "{{studentId1}}",
      "isUnknown": false,
      "confidence": 0.96,
      "timestamp": "2026-03-12T10:05:00.000Z",
      "boundingBox": { "x": 100, "y": 120, "w": 80, "h": 80 }
    },
    {
      "studentId": "{{studentId2}}",
      "isUnknown": false,
      "confidence": 0.93,
      "timestamp": "2026-03-12T10:06:00.000Z",
      "boundingBox": { "x": 140, "y": 120, "w": 80, "h": 80 }
    }
  ]
}

### Send Known Recognition Events - Batch 2
POST {{baseUrl}}/ai/recognition-events
x-ai-api-key: {{aiApiKey}}
Content-Type: application/json

{
  "sessionId": "{{sessionId}}",
  "cameraId": "cam-01",
  "events": [
    {
      "studentId": "{{studentId1}}",
      "isUnknown": false,
      "confidence": 0.95,
      "timestamp": "2026-03-12T10:20:00.000Z",
      "boundingBox": { "x": 100, "y": 120, "w": 80, "h": 80 }
    },
    {
      "studentId": "{{studentId1}}",
      "isUnknown": false,
      "confidence": 0.94,
      "timestamp": "2026-03-12T10:40:00.000Z",
      "boundingBox": { "x": 100, "y": 120, "w": 80, "h": 80 }
    },
    {
      "studentId": "{{studentId2}}",
      "isUnknown": false,
      "confidence": 0.91,
      "timestamp": "2026-03-12T10:50:00.000Z",
      "boundingBox": { "x": 140, "y": 120, "w": 80, "h": 80 }
    }
  ]
}

