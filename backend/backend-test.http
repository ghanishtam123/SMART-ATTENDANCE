# =========================
# ALERTS
# =========================

### List Unknown Face Alerts
# @name listUnknownAlerts
GET {{baseUrl}}/alerts/unknown-faces
Authorization: Bearer {{token}}

> {%
const body = response.body || {};
const data = body.data || body;
const items = data.items || data.alerts || data || [];
if (Array.isArray(items) && items.length > 0 && items[0]._id) {
  client.global.set("unknownAlertId", items[0]._id);
}
%}

### Mark Unknown Face Alert Reviewed
PATCH {{baseUrl}}/alerts/unknown-faces/{{unknownAlertId}}/reviewed
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "reviewed": true
}

# =========================
# ATTENDANCE
# =========================

### Recalculate Attendance
POST {{baseUrl}}/attendance/sessions/{{sessionId}}/recalculate
Authorization: Bearer {{token}}

### Get Session Attendance Records
GET {{baseUrl}}/attendance/sessions/{{sessionId}}/records
Authorization: Bearer {{token}}

### Finalize Attendance
POST {{baseUrl}}/attendance/sessions/{{sessionId}}/finalize
Authorization: Bearer {{token}}

### Get Student 1 Attendance History
GET {{baseUrl}}/attendance/students/{{studentId1}}/history
Authorization: Bearer {{token}}

### Get Student 2 Attendance History
GET {{baseUrl}}/attendance/students/{{studentId2}}/history
Authorization: Bearer {{token}}

### Get Student 3 Attendance History
GET {{baseUrl}}/attendance/students/{{studentId3}}/history
Authorization: Bearer {{token}}

# =========================
# SESSION SUMMARY / ANALYTICS
# =========================

### Get Session Summary
GET {{baseUrl}}/attendance/sessions/{{sessionId}}/summary
Authorization: Bearer {{token}}

### Attendance Overview
GET {{baseUrl}}/analytics/attendance-overview?from=2026-03-01&to=2026-03-31
Authorization: Bearer {{token}}

### Low Attendance Students
GET {{baseUrl}}/analytics/low-attendance?threshold=75
Authorization: Bearer {{token}}

### Late Entries Report
GET {{baseUrl}}/analytics/late-entries?from=2026-03-01&to=2026-03-31
Authorization: Bearer {{token}}

### Session Absentees
GET {{baseUrl}}/analytics/session-absentees/{{sessionId}}
Authorization: Bearer {{token}}

### Class Group Summary
GET {{baseUrl}}/attendance/class-groups/{{classGroupId}}/summary?from=2026-03-01&to=2026-03-31
Authorization: Bearer {{token}}

# =========================
# SECURITY / NEGATIVE TESTS
# =========================

### Invalid Route
GET {{baseUrl}}/this-route-does-not-exist
Authorization: Bearer {{token}}

### Invalid ObjectId Test - Student
GET {{baseUrl}}/students/invalid-object-id
Authorization: Bearer {{token}}

### Invalid ObjectId Test - Session
GET {{baseUrl}}/sessions/invalid-object-id
Authorization: Bearer {{token}}

### Access Protected Route Without Token
GET {{baseUrl}}/students

### Access Teacher/Admin Route With Wrong Token Format
GET {{baseUrl}}/students
Authorization: Bearer invalidtokenvalue

# =========================
# OPTIONAL QUICK END-TO-END ORDER
# =========================
# Run in this order:
# 1. Health Check
# 2. Login Super Admin
# 3. Create Admin User
# 4. Create Teacher User
# 5. Create Class Group
# 6. Create Classroom
# 7. Create Subject
# 8. Create Teacher Profile
# 9. Create Student 1, 2, 3
# 10. Create Session
# 11. Start Session
# 12. Send Known Recognition Events - Batch 1
# 13. Send Known Recognition Events - Batch 2
# 14. Send Late Student Event
# 15. Send Unknown Face Event
# 16. List Unknown Face Alerts
# 17. Mark Unknown Face Alert Reviewed
# 18. Recalculate Attendance
# 19. Get Session Attendance Records
# 20. Complete Session
# 21. Finalize Attendance
# 22. Get Session Summary
# 23. Attendance Overview
# 24. Student History / Reports